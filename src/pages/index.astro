---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Raghu Vadlamani">
  <h1>Robot-learning infrastructure, designed and measured</h1>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <a href={`/posts/${p.id}/`}>{p.data.title}</a>{p.data.draft && ' (draft)'}<br />
        <time>{p.data.date.toISOString().slice(0, 10)}</time>
        <div>{p.data.description}</div>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p>Nothing published yet.</p>}
</Base>
